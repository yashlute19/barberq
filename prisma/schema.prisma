generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Salon {
  id           String       @id @default(cuid())
  name         String
  phone        String?
  address      String?
  tagline      String?
  isOpen       Boolean      @default(true)
  maxQueueSize Int          @default(10)
  slotDuration Int          @default(30)
  createdAt    DateTime     @default(now())
  barbers      Barber[]
  bookings     Booking[]
  queueEntries QueueEntry[]
}

model Barber {
  id           String       @id @default(cuid())
  salonId      String
  name         String
  phone        String?
  role         String       @default("barber")
  status       String       @default("available")
  passwordHash String
  createdAt    DateTime     @default(now())
  isActive     Boolean      @default(true)
  salon        Salon        @relation(fields: [salonId], references: [id])
  bookings     Booking[]
  queueEntries QueueEntry[]
  schedule     Schedule[]
}

model Schedule {
  id        String  @id @default(cuid())
  barberId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isDayOff  Boolean @default(false)
  barber    Barber  @relation(fields: [barberId], references: [id])
}

model Booking {
  id            String   @id @default(cuid())
  salonId       String
  barberId      String?
  customerName  String
  customerPhone String
  service       String
  date          DateTime
  timeSlot      String
  duration      Int      @default(30)
  status        String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customerEmail String?
  barber        Barber?  @relation(fields: [barberId], references: [id])
  salon         Salon    @relation(fields: [salonId], references: [id])
}

model QueueEntry {
  id            String    @id @default(cuid())
  salonId       String
  barberId      String?
  customerName  String?
  customerPhone String?
  position      Int
  status        String    @default("waiting")
  joinedAt      DateTime  @default(now())
  servedAt      DateTime?
  barber        Barber?   @relation(fields: [barberId], references: [id])
  salon         Salon     @relation(fields: [salonId], references: [id])
}
